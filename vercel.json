{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "careerupdates.vercel.app"
        }
      ],
      "destination": "https://careerupdates.co.in/$1",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/ats-health",
      "schedule": "0 */12 * * *"
    }
  ]
}
